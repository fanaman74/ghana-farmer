# Express App Port
PORT=3000

# Optional Sentinel Hub API credentials
# If omitted, the server automatically generates high-fidelity local mock NDVI curves
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# OpenRouter API credentials for OLMO AI Advisor
OPENROUTER_API_KEY=

# GhanaNLP API subscription key for local Text-to-Speech (text-to-audio)
GHANANLP_API_KEY=
